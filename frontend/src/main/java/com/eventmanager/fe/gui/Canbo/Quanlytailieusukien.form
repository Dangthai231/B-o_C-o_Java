<?xml version="1.0" encoding="UTF-8"?>
<form xmlns="http://www.intellij.com/uidesigner/form/" version="1" bind-to-class="com.eventmanager.fe.gui.Canbo.Quanlytailieusukien">
  <grid id="27dc6" binding="mainPanel" custom-create="true" layout-manager="BorderLayout" hgap="0" vgap="0">
    <constraints>
      <xy x="20" y="20" width="500" height="400"/>
    </constraints>
    <properties/>
    <border type="none"/>
    <children>
      <component id="931d3" class="javax.swing.JLabel">
        <constraints border-constraint="North"/>
        <properties>
          <font name="Arial" size="24" style="1"/>
          <text value="QUẢN LÝ TÀI LIỆU SỰ KIỆN"/>
        </properties>
      </component>
      <grid id="f864d" layout-manager="FlowLayout" hgap="5" vgap="5" flow-align="0">
        <constraints border-constraint="South"/>
        <properties/>
        <border type="none">
          <title-color color="-3025959"/>
        </border>
        <children>
          <component id="26d7e" class="javax.swing.JButton" binding="btnTaiLen" custom-create="true">
            <constraints/>
            <properties>
              <text value="Tải lên tài liệu"/>
            </properties>
          </component>
          <component id="c23ec" class="javax.swing.JButton" binding="btnTaoThuMuc" custom-create="true">
            <constraints/>
            <properties>
              <text value="Tạo thư mục"/>
            </properties>
          </component>
          <component id="90f8b" class="javax.swing.JButton" binding="btnTimKiem" custom-create="true">
            <constraints/>
            <properties>
              <text value="Tìm kiếm"/>
            </properties>
          </component>
        </children>
      </grid>
      <scrollpane id="fece0">
        <constraints border-constraint="Center"/>
        <properties/>
        <border type="none"/>
        <children>
          <component id="f4f94" class="javax.swing.JTable" binding="tableTaiLieu" custom-create="true">
            <constraints/>
            <properties/>
          </component>
        </children>
      </scrollpane>
    </children>
  </grid>
</form>
